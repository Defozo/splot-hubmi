# Public deployment URL only. Never prefix credentials with VITE_.
VITE_CONVEX_URL=https://your-demo.convex.cloud
# Configure backend secrets using scripts/provision.mjs through psst:
# CONVEX_ACCESS_TOKEN, GROQ_API_KEY, OPENAI_API_KEY
# Backend runtime: APP_ENV=demo, APP_PROJECT=splot-hubmi,
# GROQ_MODEL=openai/gpt-oss-120b, EMBEDDING_MODEL=text-embedding-3-small
# Optional PDF OCR after explicit operator consent:
# OCR_MODEL=gpt-6-luna, OCR_INPUT_USD_PER_MILLION=0.1, OCR_OUTPUT_USD_PER_MILLION=0.5
# Keep OPENAI_API_KEY, GROQ_API_KEY and SPLOT_CONVEX_DEPLOY_KEY in psst/backend only.
